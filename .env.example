# =============================================================================
# PAVOX — Variáveis de ambiente
# Projeto: Vite + TanStack Start (NÃO é Next.js — o prefixo público é VITE_,
# nunca NEXT_PUBLIC_). Copie este arquivo para .env e preencha os valores.
# NÃO coloque valores reais/segredos aqui. NÃO faça commit de .env.
# =============================================================================

# -----------------------------------------------------------------------------
# PÚBLICAS / CLIENT-SIDE (injetadas no bundle em build-time via import.meta.env)
# OBRIGATÓRIAS. Sem elas o client do navegador falha ao inicializar e o LOGIN
# quebra por completo. A publishable key é pública por design (protegida por RLS).
# Necessárias em Production E Preview.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Opcional (referência do projeto Supabase; não é lida diretamente pelo app)
VITE_SUPABASE_PROJECT_ID=

# -----------------------------------------------------------------------------
# SERVER-SIDE (lidas via process.env no SSR / server functions / middleware)
# OBRIGATÓRIAS para SSR e para as rotas autenticadas (auth middleware).
# Mesmos valores das VITE_* acima (URL e publishable key).
# Necessárias em Production E Preview.
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Chave SECRETA (service role) — bypassa RLS. Usada apenas por operações
# administrativas server-side (client.server.ts / supabaseAdmin).
# NÃO é necessária para o fluxo de login. Defina somente se usar essas
# operações. NUNCA expor no client. Necessária em Production (e Preview se usada).
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# OPCIONAIS — autenticação de cron/edge (src/integrations/supabase/cron-auth.ts)
# Só necessárias se houver jobs de cron chamando as rotas protegidas por segredo.
# Não têm relação com o login.
# -----------------------------------------------------------------------------
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
